# ==========================================
# FRONTEND - VALORES PUBLICOS
# ==========================================

FRONTEND_PORT=4200
ENTRA_TENANT_ID=<tenant-id>
ENTRA_SPA_CLIENT_ID=<spa-client-id>
ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/
ENTRA_REDIRECT_URI=http://localhost:4200
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:4200
ENTRA_API_SCOPE=api://<api-client-id>/pedidos360.access
API_BASE_URL=http://localhost:8080/api/v1

# ==========================================
# BFF
# ==========================================

BFF_PORT=8080
BFF_HTTP_CONNECT_TIMEOUT=3s
BFF_HTTP_READ_TIMEOUT=10s
JWT_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
JWT_AUDIENCE=<api-client-id>
ORDERS_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
REPORT_SERVICE_URL=http://localhost:8084
AUDIT_SERVICE_URL=http://localhost:8085
ALLOWED_ORIGINS=http://localhost:4200
API_DOCS_ENABLED=false

# ==========================================
# MICROSERVICIOS
# ==========================================

ORDERS_PORT=8081
ORDERS_BIND_ADDRESS=127.0.0.1
ORDERS_HTTP_CONNECT_TIMEOUT=2s
ORDERS_HTTP_READ_TIMEOUT=3s
ORDERS_SERVICE_CLIENT_ID=<orders-service-client-id>
ORDERS_SERVICE_CLIENT_SECRET=<configurar-solo-fuera-de-git>
ORDERS_TOKEN_URI=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
ORDERS_CATALOG_SCOPE=api://<api-client-id>/.default
CATALOG_PORT=8082
CATALOG_BIND_ADDRESS=127.0.0.1
NOTIFY_PORT=8083
REPORT_PORT=8084
REPORT_BIND_ADDRESS=127.0.0.1
AUDIT_PORT=8085
AUDIT_BIND_ADDRESS=127.0.0.1

# ==========================================
# POSTGRESQL - DESARROLLO LOCAL
# ==========================================

# Valores de referencia, no contraseñas reales. Reemplazarlos solo fuera de Git.
# Spring Boot no carga este archivo automáticamente; ver docs/POSTGRESQL_LOCAL.md.
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=<define-una-clave-de-administracion>
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/pedidos360_catalog
CATALOG_DB_USERNAME=pedidos360_catalog
CATALOG_DB_PASSWORD=<define-otra-clave-para-catalog>
ORDERS_POSTGRES_PORT=5433
ORDERS_DB_URL=jdbc:postgresql://localhost:5433/pedidos360_orders
ORDERS_DB_USERNAME=pedidos360_orders
ORDERS_DB_PASSWORD=<define-otra-clave-para-orders>
AUDIT_POSTGRES_PORT=5434
AUDIT_DB_URL=jdbc:postgresql://localhost:5434/pedidos360_audit
AUDIT_DB_USERNAME=pedidos360_audit
AUDIT_DB_PASSWORD=<define-otra-clave-para-audit>
REPORT_POSTGRES_PORT=5435
REPORT_DB_URL=jdbc:postgresql://localhost:5435/pedidos360_report
REPORT_DB_USERNAME=pedidos360_report
REPORT_DB_PASSWORD=<define-otra-clave-para-report>

# Cada microservicio utiliza su propia base y usuario.

# ==========================================
# RABBITMQ - COMANDOS, DLQ Y ADMINISTRACION (EP3)
# ==========================================

# Topología, contrato y comandos de Docker Compose: docs/RABBITMQ.md.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<rabbit-user>
RABBITMQ_PASSWORD=<rabbit-password>
RABBITMQ_EMAIL_QUEUE=q.cmd.email
RABBITMQ_EMAIL_DLQ=q.cmd.email.dlq
RABBITMQ_VHOST=pedidos360
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
# Orders publica email.send, email.send.high, kitchen.ticket e invoice.gen desde su outbox.
ORDERS_NOTIFICATIONS_ENABLED=false
ORDERS_NOTIFICATIONS_POLL_DELAY=1000
ORDERS_NOTIFICATIONS_MAX_ATTEMPTS=20
# Consumidores opcionales (compose.commands.yml los habilita en Docker).
CATALOG_COMMANDS_ENABLED=false
REPORT_COMMANDS_ENABLED=false
AUDIT_DEAD_LETTERS_ENABLED=false
# Microservicio administrador de RabbitMQ (mq-admin).
MQ_ADMIN_PORT=8086
MQ_ADMIN_BIND_ADDRESS=127.0.0.1
MQ_ADMIN_ALERT_THRESHOLD=1
MQ_ADMIN_ALERT_INTERVAL=30s
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
NOTIFY_BIND_ADDRESS=127.0.0.1
NOTIFY_EMAIL_FROM=no-reply@pedidos360.test
NOTIFY_EMAIL_RECIPIENT=demo@pedidos360.test

# ==========================================
# KAFKA - ALCANCE BASICO
# ==========================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ORDERS_TOPIC=orders.events
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=cGVkaWRvczM2MC1rYWZrYQ
ORDERS_EVENTS_ENABLED=false
ORDERS_EVENTS_POLL_DELAY=1000
AUDIT_EVENTS_ENABLED=true
AUDIT_KAFKA_GROUP=pedidos360-audit-v1
REPORT_EVENTS_ENABLED=true
REPORT_KAFKA_GROUP=pedidos360-report-v1

# ==========================================
# AWS
# ==========================================

AWS_REGION=<aws-region>
AWS_API_GATEWAY_URL=<api-gateway-url>
AWS_BFF_INTEGRATION_URL=<bff-integration-url>
AWS_FRONTEND_ORIGIN=http://localhost:4200
