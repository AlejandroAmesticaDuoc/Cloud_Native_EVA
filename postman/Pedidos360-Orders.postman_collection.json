                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"orderId\", pm.response.json().id);",
                  "pm.test(\"Total calculado por Orders\", () => pm.expect(pm.response.json().total).to.eql(2501));"
