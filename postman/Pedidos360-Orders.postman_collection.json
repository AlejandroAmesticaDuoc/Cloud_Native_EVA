{
  "info": {
    "name": "Pedidos360 - Flujo Orders",
    "description": "Ejecutar carpetas en orden en desarrollo. Usa usuarios reales ADMIN, OPERADOR y CLIENTE, todos con scope pedidos360.access. La identidad técnica de Orders debe estar configurada en el servidor. Crea productos y pedidos: no ejecutar en producción. No exportar tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "ordersUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "clientToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "operatorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Salud y producto",
      "item": [
        {
          "name": "Salud BFF",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Trace-Id",
                "value": "postman-orders-{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness Orders",
          "request": {
            "method": "GET",
            "url": "{{ordersUrl}}/actuator/health/readiness",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Trace-Id",
                "value": "postman-orders-{{$guid}}"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto como ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/catalog",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Trace-Id",
                "value": "postman-orders-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Producto prueba Orders\",\"price\":1250.50,\"stock\":10}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"productId\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Crear y comprobar permisos",
      "item": [
        {
          "name": "Crear pedido del cliente",
          "request": {
